{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.accord.inforvans.com/acceptance/foundation-verdict/1-0-0",
  "title": "Accord Foundation Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_policy_version",
    "kind",
    "status",
    "remote_url",
    "remote_ref",
    "remote_sha",
    "tree_sha",
    "image_lock_digest",
    "release_manifest_digest",
    "dependency_lock_digests",
    "toolchain_results",
    "checks",
    "demo_evidence",
    "started_at",
    "ended_at",
    "evidence_bundle_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "evidence_policy_version": { "const": "accord-foundation-evidence-v1" },
    "kind": { "enum": ["CODE", "ENVIRONMENT"] },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "remote_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "remote_ref": {
      "type": "string",
      "pattern": "^refs/[A-Za-z0-9][A-Za-z0-9._/-]{1,1023}$"
    },
    "remote_sha": { "$ref": "#/$defs/gitObjectId" },
    "tree_sha": { "$ref": "#/$defs/gitObjectId" },
    "image_lock_digest": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/digest" }
      ]
    },
    "release_manifest_digest": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/digest" }
      ]
    },
    "dependency_lock_digests": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "toolchain_results": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required_version", "observed_version", "status"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
          "required_version": { "type": "string", "minLength": 1, "maxLength": 64 },
          "observed_version": {
            "anyOf": [
              { "type": "null" },
              { "type": "string", "minLength": 1, "maxLength": 128 }
            ]
          },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED"] }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/passCheck" },
          { "$ref": "#/$defs/failCheck" },
          { "$ref": "https://schemas.accord.inforvans.com/acceptance/blocked-evidence/1-0-0" }
        ]
      }
    },
    "demo_evidence": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "evidence_bundle_digest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": {
        "properties": {
          "image_lock_digest": { "$ref": "#/$defs/digest" },
          "release_manifest_digest": { "$ref": "#/$defs/digest" },
          "checks": { "type": "array", "items": { "$ref": "#/$defs/passCheck" } },
          "toolchain_results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "status": { "const": "PASS" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "FAIL" } }, "required": ["status"] },
      "then": {
        "properties": {
          "checks": {
            "type": "array",
            "contains": { "$ref": "#/$defs/failCheck" },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "BLOCKED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/passCheck" },
                { "$ref": "https://schemas.accord.inforvans.com/acceptance/blocked-evidence/1-0-0" }
              ]
            },
            "contains": { "$ref": "https://schemas.accord.inforvans.com/acceptance/blocked-evidence/1-0-0" },
            "minContains": 1
          },
          "toolchain_results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "status": { "enum": ["PASS", "BLOCKED"] } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "CODE" }, "status": { "const": "PASS" } },
        "required": ["kind", "status"]
      },
      "then": {
        "properties": {
          "dependency_lock_digests": { "type": "array", "minItems": 1 },
          "toolchain_results": { "type": "array", "minItems": 1 },
          "demo_evidence": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "checkId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,127}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitObjectId": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "passCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status",
        "attempted_argv",
        "attempt_exit_code",
        "evidence_digests",
        "occurred_at",
        "owner"
      ],
      "properties": {
        "check_id": { "$ref": "#/$defs/checkId" },
        "status": { "const": "PASS" },
        "attempted_argv": { "$ref": "#/$defs/argv" },
        "attempt_exit_code": { "const": 0 },
        "evidence_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "occurred_at": { "type": "string", "format": "date-time" },
        "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.@-]{1,127}$" }
      }
    },
    "failCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status",
        "reason_code",
        "executed",
        "attempted_argv",
        "attempt_exit_code",
        "evidence_digests",
        "occurred_at",
        "owner"
      ],
      "properties": {
        "check_id": { "$ref": "#/$defs/checkId" },
        "status": { "const": "FAIL" },
        "reason_code": { "const": "ASSERTION_FAILED" },
        "executed": { "const": true },
        "attempted_argv": { "$ref": "#/$defs/argv" },
        "attempt_exit_code": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "evidence_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "occurred_at": { "type": "string", "format": "date-time" },
        "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.@-]{1,127}$" }
      }
    }
  }
}
