{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.accord.inforvans.com/acceptance/blocked-evidence/1-0-0",
  "title": "Accord Foundation Blocked Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "check_id",
    "status",
    "remote_sha",
    "tree_sha",
    "reason_code",
    "attempted_argv",
    "attempt_exit_code",
    "attempt_evidence",
    "rerun_argv",
    "occurred_at",
    "owner"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "check_id": { "$ref": "#/$defs/checkId" },
    "status": { "const": "BLOCKED" },
    "remote_sha": { "$ref": "#/$defs/gitObjectId" },
    "tree_sha": { "$ref": "#/$defs/gitObjectId" },
    "reason_code": {
      "enum": [
        "BLOCKED_TOOLCHAIN",
        "BLOCKED_REMOTE_AUTHORITY",
        "BLOCKED_BRANCH_PROTECTION",
        "BLOCKED_MIRROR",
        "BLOCKED_OIDC",
        "BLOCKED_REGISTRY",
        "BLOCKED_KUBERNETES",
        "BLOCKED_ARGOCD",
        "BLOCKED_EXTERNAL_SECRET",
        "BLOCKED_PKI",
        "BLOCKED_DATABASE_RECOVERY",
        "BLOCKED_OBJECT_CAPABILITY",
        "BLOCKED_PLATFORM_SIGNING",
        "BLOCKED_BY_PROVIDER_ADAPTER"
      ]
    },
    "attempted_argv": { "$ref": "#/$defs/argv" },
    "attempt_exit_code": {
      "anyOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      ]
    },
    "attempt_evidence": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "rerun_argv": { "$ref": "#/$defs/argv" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_.@-]*$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required_version", "observed_version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
        "required_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "observed_version": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 128 }
          ]
        }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "authority", "required_evidence_type"],
      "properties": {
        "capability": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,127}$" },
        "authority": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:@/-]{1,255}$" },
        "required_evidence_type": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{1,127}$" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "reason_code": { "const": "BLOCKED_TOOLCHAIN" } },
        "required": ["reason_code"]
      },
      "then": {
        "required": ["tool"],
        "properties": { "tool": true, "external": false }
      },
      "else": {
        "required": ["external"],
        "properties": { "external": true, "tool": false }
      }
    }
  ],
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "checkId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{1,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    }
  }
}
