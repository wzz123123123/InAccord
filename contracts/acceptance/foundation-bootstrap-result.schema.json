{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.accord.inforvans.com/acceptance/foundation-bootstrap-result/1-0-0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "reason_code",
    "remote_url",
    "remote_ref",
    "requested_remote_sha",
    "attempted_argv",
    "attempt_exit_code",
    "attempt_evidence",
    "rerun_argv",
    "occurred_at",
    "owner"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "status": { "enum": ["FAIL", "BLOCKED"] },
    "reason_code": { "enum": ["ASSERTION_FAILED", "BLOCKED_REMOTE_AUTHORITY"] },
    "remote_url": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "remote_ref": { "type": "string", "pattern": "^refs/[A-Za-z0-9][A-Za-z0-9._/-]{1,1023}$" },
    "requested_remote_sha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "attempted_argv": { "$ref": "#/$defs/argv" },
    "attempt_exit_code": {
      "anyOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      ]
    },
    "attempt_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "rerun_argv": { "$ref": "#/$defs/argv" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "owner": { "const": "platform-engineering" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "BLOCKED" } }, "required": ["status"] },
      "then": { "properties": { "reason_code": { "const": "BLOCKED_REMOTE_AUTHORITY" } } },
      "else": { "properties": { "reason_code": { "const": "ASSERTION_FAILED" } } }
    }
  ],
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    }
  }
}
