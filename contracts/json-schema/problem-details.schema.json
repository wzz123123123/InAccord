{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.accord.inforvans.com/http/problem-details/1-0-0",
  "type": "object",
  "additionalProperties": true,
  "not": { "required": ["detail"] },
  "required": ["type", "title", "status", "code", "correlation_id", "instance"],
  "properties": {
    "type": { "type": "string", "format": "uri" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "integer", "minimum": 400, "maximum": 599 },
    "instance": { "type": "string", "format": "uri-reference" },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "actual_version": {
      "anyOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
      ]
    },
    "retry_after": { "type": "integer", "minimum": 1, "maximum": 120 },
    "errors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string", "minLength": 1, "maxLength": 512 },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    }
  }
}
